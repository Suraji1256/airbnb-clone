<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="max-w-7xl mx-auto px-4 py-8">

    <!-- Header -->

    <div class="mb-8">

        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
            Host Dashboard
        </h1>

        <p class="text-gray-500 mt-2">
            Manage your properties and track their performance.
        </p>

    </div>


    <!-- Statistics -->

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">

        <!-- Properties -->

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">
                        Total Properties
                    </p>

                    <h2 class="text-3xl font-bold mt-2">
                        <%= totalProperties %>
                    </h2>

                </div>

                <div class="text-3xl">
                    🏠
                </div>

            </div>

        </div>


        <!-- Rating -->

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">
                        Average Rating
                    </p>

                    <h2 class="text-3xl font-bold mt-2">
                        <%= averageRating %>
                    </h2>

                </div>

                <div class="text-3xl">
                    ⭐
                </div>

            </div>

        </div>


        <!-- Bookings -->

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">
                        Total Bookings
                    </p>

                    <h2 class="text-3xl font-bold mt-2">
                        <%= totalBookings %>
                    </h2>

                </div>

                <div class="text-3xl">
                    📅
                </div>

            </div>

        </div>


        <!-- Revenue -->

        <div class="bg-white rounded-2xl shadow-md border border-gray-100 p-6">

            <div class="flex justify-between items-center">

                <div>

                    <p class="text-gray-500 text-sm">
                        Total Revenue
                    </p>

                    <h2 class="text-3xl font-bold mt-2">
                        ₹<%= totalRevenue.toLocaleString("en-IN") %>
                    </h2>

                </div>

                <div class="text-3xl">
                    💰
                </div>

            </div>

        </div>

        <a
    href="/host/bookings"
    class="inline-flex items-center gap-2
           bg-gray-900 hover:bg-gray-700
           text-white px-5 py-3 rounded-lg">

    📅 Manage Bookings

</a>

    </div>


    <!-- My Properties -->

    <div class="bg-white rounded-2xl shadow-md border border-gray-100">

        <div class="p-6 border-b">

            <h2 class="text-2xl font-bold">
                My Properties
            </h2>

        </div>


        <% if (homes.length === 0) { %>

            <div class="p-10 text-center">

                <div class="text-5xl mb-4">
                    🏠
                </div>

                <h3 class="text-xl font-semibold">
                    No Properties Yet
                </h3>

                <p class="text-gray-500 mt-2">
                    Start by adding your first property.
                </p>

                <a
                    href="/host/add-home"
                    class="inline-block mt-5 bg-red-500 hover:bg-red-600
                           text-white px-6 py-3 rounded-lg">

                    Add Property

                </a>

            </div>

        <% } else { %>


            <div class="divide-y">

                <% homes.forEach(home => { %>

                    <div class="p-6">

                        <div class="flex flex-col md:flex-row gap-5">

                            <!-- Image -->

                            <img
                                src="<%= home.photo %>"
                                alt="<%= home.houseName %>"
                                class="w-full md:w-48 h-32 object-cover rounded-xl">


                            <!-- Details -->

                            <div class="flex-1">

                                <div class="flex flex-col sm:flex-row
                                            justify-between gap-3">

                                    <div>

                                        <h3 class="text-xl font-bold">
                                            <%= home.houseName %>
                                        </h3>

                                        <p class="text-gray-500 mt-1">
                                            📍 <%= home.location %>
                                        </p>

                                    </div>

                                    <div class="text-lg font-semibold">
                                        ₹<%= home.price %> / night
                                    </div>

                                </div>


                                <div class="flex flex-wrap gap-4 mt-4">

                                    <span class="text-yellow-500">
                                        ⭐ <%= home.averageRating.toFixed(1) %>
                                    </span>

                                    <span class="text-gray-500">
                                        <%= home.propertyType %>
                                    </span>

                                </div>


                                <!-- Actions -->

                                <div class="flex gap-3 mt-5">

                                    <a
                                        href="/host/edit-home/<%= home._id %>"
                                        class="bg-blue-500 hover:bg-blue-600
                                               text-white px-4 py-2 rounded-lg">

                                        Edit

                                    </a>

                                    <a
                                        href="/homes/<%= home._id %>"
                                        class="bg-gray-100 hover:bg-gray-200
                                               text-gray-700 px-4 py-2 rounded-lg">

                                        View

                                    </a>

                                    <form
                                        action="/host/delete-home/<%= home._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this property?');">

                                    <button
                                        type="submit"
                                        class="bg-red-500 hover:bg-red-600
                                        text-white px-4 py-2 rounded-lg">

                                        🗑 Delete

                                    </button>

                                </form>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

    <!-- ==========================================
     RECENT BOOKINGS
========================================== -->

<div class="bg-white rounded-2xl shadow-md border border-gray-100 mt-8">

    <!-- Section Header -->

    <div class="p-6 border-b">

        <h2 class="text-2xl font-bold text-gray-800">
            Recent Bookings
        </h2>

        <p class="text-gray-500 mt-1">
            Latest bookings for your properties.
        </p>

    </div>


    <% if (!bookings || bookings.length === 0) { %>

        <!-- No Bookings -->

        <div class="p-10 text-center">

            <div class="text-5xl mb-4">
                📅
            </div>

            <h3 class="text-xl font-semibold text-gray-800">
                No Bookings Yet
            </h3>

            <p class="text-gray-500 mt-2">
                Bookings for your properties will appear here.
            </p>

        </div>

    <% } else { %>

        <!-- Booking Table -->

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-gray-50">

                    <tr>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Guest
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Property
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Check In
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Check Out
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Guests
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Amount
                        </th>

                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% bookings.slice(0, 5).forEach(booking => { %>

                        <tr class="border-t hover:bg-gray-50">

                            <!-- Guest -->

                            <td class="p-4">

                                <%= booking.user?.name ||
                                    booking.user?.email ||
                                    "Guest" %>

                            </td>


                            <!-- Property -->

                            <td class="p-4 font-medium">

                                <%= booking.home?.houseName ||
                                    "Property" %>

                            </td>


                            <!-- Check In -->

                            <td class="p-4">

                                <%= new Date(booking.checkIn).toDateString() %>

                            </td>


                            <!-- Check Out -->

                            <td class="p-4">

                                <%= new Date(booking.checkOut).toDateString() %>

                            </td>


                            <!-- Guests -->

                            <td class="p-4">

                                <%= booking.guests %>

                            </td>


                            <!-- Amount -->

                            <td class="p-4 font-semibold">

                                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                            </td>


                            <!-- Status -->

                            <td class="p-4">

                                <% if (booking.status === "Confirmed") { %>

                                    <span
                                        class="inline-block bg-green-100
                                               text-green-700 px-3 py-1
                                               rounded-full text-sm">

                                        Confirmed

                                    </span>

                                <% } else { %>

                                    <span
                                        class="inline-block bg-red-100
                                               text-red-700 px-3 py-1
                                               rounded-full text-sm">

                                        Cancelled

                                    </span>

                                <% } %>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

</div>

</main>