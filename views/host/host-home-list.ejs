<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-br from-gray-50 to-gray-100 font-sans">

    <%- include('../partials/header') %>
    <%- include("../partials/flash") %>
    <% if (typeof queryError !== "undefined" && queryError === "activeBooking") { %>

    <div class="mb-6 bg-red-100 border border-red-300
                text-red-700 px-5 py-4 rounded-xl">

        <p class="font-semibold">
            Cannot delete this property.
        </p>

        <p class="text-sm mt-1">
            This property has an active or upcoming booking.
            You can delete it after all active bookings are completed.
        </p>

    </div>

<% } %>



<% if (typeof querySuccess !== "undefined" && querySuccess === "deleted") { %>

    <div class="mb-6 bg-green-100 border border-green-300
                text-green-700 px-5 py-4 rounded-xl">

        <p class="font-semibold">
            Property deleted successfully.
        </p>

    </div>

<% } %>

    <!-- Main Section -->
    <main
    class="max-w-7xl mx-auto
           px-4 sm:px-6
           py-8 sm:py-12">

        <!-- Heading -->
        <div class="text-center mb-10">

            <h2
    class="text-2xl sm:text-3xl lg:text-4xl
           font-extrabold text-gray-800">
    🏠 Hey Host, Here Are Your Homes
</h2>

            <p class="text-gray-500 mt-3">
                Manage and update all your registered properties.
            </p>

        </div>


        <!-- Homes Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">

            <% registeredHomes.forEach(home => { %>

            <!-- Home Card -->
            <div
                class="group bg-white rounded-2xl overflow-hidden
                       border border-gray-200
                       shadow-md hover:shadow-2xl
                       hover:-translate-y-2
                       transition-all duration-300 ease-in-out">

                <!-- Image -->
                <div class="relative overflow-hidden">

                    <img
                        src="<%= home.photo %>"
                        alt="<%= home.houseName %>"
                        class="w-full h-52 object-cover
                               group-hover:scale-110
                               transition-transform duration-500 ease-in-out">

                    <!-- Dark overlay on hover -->
                    <div
                        class="absolute inset-0 bg-black/0
                               group-hover:bg-black/10
                               transition duration-300">
                    </div>

                    <!-- Rating -->
                    <span
                        class="absolute top-3 right-3
                               bg-white/95 backdrop-blur-sm
                               px-3 py-1.5
                               rounded-full
                               shadow-lg
                               text-sm font-semibold
                               text-gray-800">
                        ⭐ <%= home.rating %>
                    </span>

                    <!-- Available Badge -->
                    <span
                        class="absolute top-3 left-3
                               bg-green-500
                               text-white
                               text-xs font-semibold
                               px-3 py-1.5
                               rounded-full
                               shadow-md">
                        Available
                    </span>

                </div>


                <!-- Details -->
                <div class="p-5">

                    <!-- House Name -->
                    <h2
                        class="text-xl font-bold text-gray-800 truncate
                               group-hover:text-rose-600
                               transition duration-300">
                        <%= home.houseName %>
                    </h2>


                    <!-- Location -->
                    <div class="flex items-center gap-1.5 mt-2">

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-rose-500 flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>

                        </svg>

                        <p class="text-gray-500 text-sm truncate">
                            <%= home.location %>
                        </p>

                    </div>


                    <!-- Divider -->
                    <div class="border-t border-gray-100 my-4"></div>


                    <!-- Price -->
                    <div class="flex items-end justify-between">

                        <div>

                            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide">
                                Price
                            </p>

                            <div class="mt-1">

                                <span class="text-2xl font-extrabold text-rose-600">
                                    ₹<%= home.price %>
                                </span>

                                <span class="text-sm text-gray-500">
                                    / night
                                </span>

                            </div>

                        </div>

                        <!-- Status -->
                        <span
                            class="bg-green-50
                                   border border-green-200
                                   text-green-600
                                   text-xs font-semibold
                                   px-3 py-1.5
                                   rounded-full">
                            ● Active
                        </span>

                    </div>


                    <!-- Buttons -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">

                       <a href="/host/edit-home/<%= home._id %>?editing=true"
   class="flex items-center justify-center gap-2
          bg-blue-500 hover:bg-blue-600
          active:scale-95
          text-white
          py-2.5
          rounded-xl
          font-semibold
          shadow-sm hover:shadow-lg
          transition-all duration-200">

    <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor">

        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.5-9.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 7.5-7.5z"/>
    </svg>

    Edit

</a>


                <!-- Delete Button -->
<form
    action="/host/delete-home/<%= home._id %>"
    method="POST"
    class="w-full">

    <button
        type="submit"
        class="w-full flex items-center justify-center gap-2
               bg-red-50 hover:bg-red-500
               text-red-600 hover:text-white
               border border-red-200 hover:border-red-500
               py-2.5
               rounded-xl
               font-semibold
               shadow-sm hover:shadow-md
               active:scale-95
               transition-all duration-200">

        <!-- Delete Icon -->
        Delete Home

    </button>

</form>


                    </div>

                </div>

            </div>

            <% }) %>

        </div>

    </main>

</body>
</html>