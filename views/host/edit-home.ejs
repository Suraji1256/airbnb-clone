            <!-- Kitchen Icon -->
            <div
                class="flex
                       items-center
                       justify-center
                       w-10
                       h-10
                       rounded-lg
                       bg-orange-50
                       text-orange-500">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="w-5 h-5">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7 2v10
                           M5 2v4
                           M9 2v4
                           M7 12v10
                           M16 2v20
                           M16 2c2 2 2 5 0 7"/>

                </svg>

            </div>

            <span class="text-sm font-medium text-gray-700">
                Kitchen
            </span>

        </label>


        <!-- ================= POOL ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
                   duration-200
                   hover:border-cyan-300
                   hover:bg-cyan-50/50
                   hover:shadow-sm
                   has-[:checked]:border-cyan-500
                   has-[:checked]:bg-cyan-50
                   has-[:checked]:shadow-sm">

            <input
                type="checkbox"
                name="amenities"
                value="Pool"
                class="w-4 h-4
                       shrink-0
                       accent-rose-500
                       cursor-pointer"
                <%= editing && home.amenities?.includes("Pool") ? "checked" : "" %>>


            <!-- Pool Icon -->
            <div
                class="flex
                       items-center
                       justify-center
                       w-10
                       h-10
                       rounded-lg
                       bg-cyan-50
                       text-cyan-500">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="w-5 h-5">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 18c2 2 4 2 6 0
                           s4-2 6 0
                           s4 2 6 0
                           M8 14V9a4 4 0 1 1 8 0v5"/>

                </svg>

            </div>

            <span class="text-sm font-medium text-gray-700">
                Pool
            </span>

        </label>


        <!-- ================= TV ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
                   duration-200
                   hover:border-purple-300
                   hover:bg-purple-50/50
                   hover:shadow-sm
                   has-[:checked]:border-purple-500
                   has-[:checked]:bg-purple-50
                   has-[:checked]:shadow-sm">

            <input
                type="checkbox"
                name="amenities"
                value="TV"
                class="w-4 h-4
                       shrink-0
                       accent-rose-500
                       cursor-pointer"
                <%= editing && home.amenities?.includes("TV") ? "checked" : "" %>>


            <!-- TV Icon -->
            <div
                class="flex
                       items-center
                       justify-center
                       w-10
                       h-10
                       rounded-lg
                       bg-purple-50
                       text-purple-500">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="w-5 h-5">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 6h18v12H3V6Zm6-3 3 3 3-3"/>

                </svg>

            </div>

            <span class="text-sm font-medium text-gray-700">
                TV
            </span>

        </label>

    </div>

</div>



                    <label
                        for="Photo"
                        class="block text-gray-700 font-semibold mb-2">
                        House Photo
                    </label>


    <input
    id="housePhoto"
    type="file"
    name="photo"
    accept="image/png, image/jpeg, image/jpg, image/webp"
    class="
        w-full
        rounded-xl
        border
        border-gray-300
        bg-white
        px-3
        py-2
        text-sm
        text-gray-600
        cursor-pointer
        shadow-sm

        hover:border-rose-400
        hover:bg-rose-50

        focus:outline-none
        focus:border-rose-500
        focus:ring-2
        focus:ring-rose-100

        transition-all
        duration-200

        file:mr-3
        file:rounded-lg
        file:border-0
        file:bg-rose-500
        file:px-4
        file:py-2
        file:text-sm
        file:font-semibold
        file:text-white
        file:cursor-pointer

        file:hover:bg-rose-600
    "
>
                    <label
                        for="Description"
                        class="block text-gray-700 font-semibold mb-2">
                        House Description
                    </label>

                    <textarea
                        id="houseDescription"
                        type="text"
                        name="description"
                        placeholder="Describe Your Home"
                        required
                        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-rose-500 focus:ring-4 focus:ring-rose-200 outline-none transition"
                    ><%= editing ? home.description : '' %></textarea>


                </div>

                <button
                    type="submit"
                    class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-3 rounded-xl shadow-lg hover:shadow-xl transition duration-300">
                    <%= editing ? "Update Home" : "+ Add Home" %>
                </button>

            </form>

            <!-- Divider -->
            <div class="flex items-center my-8">
                <div class="flex-grow border-t border-gray-200"></div>
                <span class="px-3 text-gray-400 text-sm">Host with confidence</span>
                <div class="flex-grow border-t border-gray-200"></div>
            </div>

            <!-- Features -->
            <div class="grid grid-cols-3 gap-4 text-center text-sm">

                <div class="bg-gray-50 rounded-xl p-4">
                    <div class="text-2xl">💰</div>
                    <p class="mt-2 font-medium">Earn Money</p>
                </div>

                <div class="bg-gray-50 rounded-xl p-4">
                    <div class="text-2xl">🔒</div>
                    <p class="mt-2 font-medium">Safe Hosting</p>
                </div>

                <div class="bg-gray-50 rounded-xl p-4">
                    <div class="text-2xl">🌍</div>
                    <p class="mt-2 font-medium">Global Guests</p>
                </div>

            </div>

            <!-- Footer -->
            <p class="text-center text-gray-500 text-sm mt-8">
                Your home could be someone's next favorite stay.
            </p>

        </div>

    </main>

</body>

</html>