<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-pink-100 font-sans">

    <%- include('../partials/header') %>

    <!-- Main Container -->
    <main class="flex items-center justify-center py-16 px-4">

        <!-- Card -->
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl p-10 border border-gray-100">

            <!-- Icon -->
            <div class="flex justify-center mb-5">
                <div class="w-20 h-20 rounded-full bg-rose-100 flex items-center justify-center text-4xl">
                    🏠
                </div>
            </div>

            <!-- Heading -->
            <div class="text-center mb-8">
                <h1 class="text-4xl font-bold text-rose-600">
                    <%= editing ? "Edit" : "Register" %> Your Home
                </h1>

                <p class="text-gray-500 mt-3">
                    List your property on Airbnb and start earning today.
                </p>
            </div>

            <!-- Form -->
            <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" enctype="multipart/form-data" class="space-y-6">

                <div>
                    <input
                        id="houseId"
                        type="hidden"
                        name="id"
                        value="<%= editing ? home._id : '' %>"
                        placeholder="Enter your house Id"
                        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-rose-500 focus:ring-4 focus:ring-rose-200 outline-none transition"
                    >

                    <label
                        for="houseName"
                        class="block text-gray-700 font-semibold mb-2">
                        House Name
                    </label>

                    <input
                        id="houseName"
                        type="text"
                        name="houseName"
                        value="<%= editing ? home.houseName : '' %>"
                        placeholder="Enter your house name"
                        required
                        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-rose-500 focus:ring-4 focus:ring-rose-200 outline-none transition"
                    >

                    <label
                        for="Price"
                        class="block text-gray-700 font-semibold mb-2">
                        House Price
                    </label>

                    <input
                        id="housePrice"
                        type="text"
                        name="price"
                        value="<%= editing ? home.price : '' %>"
                        placeholder="Price per Night"
                        required
                        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-rose-500 focus:ring-4 focus:ring-rose-200 outline-none transition"
                    >

                    <label
                        for="Location"
                        class="block text-gray-700 font-semibold mb-2">
                        House Location
                    </label>

                    <input
                        id="houseLocation"
                        type="text"
                        name="location"
                        value="<%= editing ? home.location : '' %>"
                        placeholder="Enter your Location"
                        required
                        class="w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-rose-500 focus:ring-4 focus:ring-rose-200 outline-none transition"
                    >

                    <label
                        for="propertyType"
                        class="block font-semibold mb-2">

                        Property Type

                    </label>

                <select
                    id="propertyType"
                    name="propertyType"
                    required
                    class="w-full
                    rounded-xl
                    border border-gray-300
                    px-4 py-3
                    bg-white
                    focus:border-rose-500
                    focus:ring-4
                    focus:ring-rose-200
                    outline-none
                    transition">

                <option value="" disabled selected>
                    Select Property Type
                </option>

                <option
                value="Apartment"
                <%= editing && home.propertyType === "Apartment" ? "selected" : "" %>>
                Apartment
                </option>

        <option
            value="Villa"
            <%= editing && home.propertyType === "Villa" ? "selected" : "" %>>
            Villa
        </option>

        <option
            value="House"
            <%= editing && home.propertyType === "House" ? "selected" : "" %>>
            House
        </option>

        <option
            value="Cabin"
            <%= editing && home.propertyType === "Cabin" ? "selected" : "" %>>
            Cabin
        </option>

    </select>




<!-- ================= Amenities ================= -->

<!-- ================= AMENITIES ================= -->

<div class="mt-8">

    <!-- Section Heading -->
    <div class="mb-4">

        <label
            for="amenities"
            class="block text-lg font-semibold text-gray-900">

            Amenities

        </label>

        <p class="text-sm text-gray-500 mt-1">
            Select the amenities available at your property.
        </p>

    </div>


    <!-- Amenities Container -->
    <div
        class="grid
               grid-cols-1
               sm:grid-cols-2
               lg:grid-cols-3
               gap-3
               p-1">


        <!-- ================= WIFI ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
                   duration-200
                   hover:border-rose-300
                   hover:bg-rose-50/50
                   hover:shadow-sm
                   has-[:checked]:border-rose-500
                   has-[:checked]:bg-rose-50
                   has-[:checked]:shadow-sm">

            <input
                type="checkbox"
                name="amenities"
                value="WiFi"
                class="w-4 h-4
                       shrink-0
                       accent-rose-500
                       cursor-pointer"
                <%= editing && home.amenities?.includes("WiFi") ? "checked" : "" %>>


            <!-- WiFi Icon -->
            <div
                class="flex
                       items-center
                       justify-center
                       w-10
                       h-10
                       rounded-lg
                       bg-rose-50
                       text-rose-500
                       group-has-[:checked]:bg-rose-100">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="w-5 h-5">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.111 16.404a5.5 5.5 0 0 1 7.778 0
                           M5.282 13.575a9.5 9.5 0 0 1 13.436 0
                           M2.454 10.747a13.5 13.5 0 0 1 19.092 0
                           M12 20.25h.008v.008H12v-.008Z"/>

                </svg>

            </div>

            <span class="text-sm font-medium text-gray-700">
                WiFi
            </span>

        </label>


        <!-- ================= AC ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
                   duration-200
                   hover:border-sky-300
                   hover:bg-sky-50/50
                   hover:shadow-sm
                   has-[:checked]:border-sky-500
                   has-[:checked]:bg-sky-50
                   has-[:checked]:shadow-sm">

            <input
                type="checkbox"
                name="amenities"
                value="AC"
                class="w-4 h-4
                       shrink-0
                       accent-rose-500
                       cursor-pointer"
                <%= editing && home.amenities?.includes("AC") ? "checked" : "" %>>


            <!-- AC Icon -->
            <div
                class="flex
                       items-center
                       justify-center
                       w-10
                       h-10
                       rounded-lg
                       bg-sky-50
                       text-sky-500">

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.8"
                    stroke="currentColor"
                    class="w-5 h-5">

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 2v20
                           M4.93 6l14.14 12
                           M19.07 6 4.93 18
                           M2 12h20"/>

                </svg>

            </div>

            <span class="text-sm font-medium text-gray-700">
                AC
            </span>

        </label>


        <!-- ================= PARKING ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
