        </label>


        <!-- ================= KITCHEN ================= -->

        <label
            class="group
                   flex
                   items-center
                   gap-3
                   min-h-[64px]
                   rounded-xl
                   border
                   border-gray-200
                   bg-white
                   px-4
                   cursor-pointer
                   transition-all
                   duration-200
                   hover:border-orange-300
                   hover:bg-orange-50/50
                   hover:shadow-sm
                   has-[:checked]:border-orange-500
                   has-[:checked]:bg-orange-50
                   has-[:checked]:shadow-sm">

            <input
                type="checkbox"
                name="amenities"
                value="Kitchen"
                class="w-4 h-4
                       shrink-0
                       accent-rose-500
