<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="max-w-4xl mx-auto px-4 py-8">

    <a
        href="/host/bookings"
        class="text-gray-600 hover:text-gray-900">

        ← Back to Bookings

    </a>


    <div class="bg-white rounded-2xl shadow-lg mt-6 overflow-hidden">

        <!-- Property -->

        <div class="md:flex">

            <% if (booking.home?.photo) { %>

                <img
                    src="<%= booking.home.photo %>"
                    alt="<%= booking.home.houseName %>"
                    class="w-full md:w-1/3 h-64 object-cover">

            <% } %>


            <div class="p-6 flex-1">

                <h1 class="text-2xl font-bold">
                    <%= booking.home?.houseName || "Property" %>
                </h1>

                <p class="text-gray-500 mt-2">
                    📍 <%= booking.home?.location || "Unknown" %>
                </p>

            </div>

        </div>


        <!-- Guest -->

        <div class="p-6 border-t">

            <h2 class="text-xl font-bold mb-4">
                Guest Information
            </h2>

            <div class="space-y-2">

                <p>
                    <strong>Name:</strong>

                    <%= booking.user?.name ||
                        booking.user?.username ||
                        "Guest" %>
                </p>

                <p>
                    <strong>Email:</strong>

                    <%= booking.user?.email || "Not available" %>
                </p>

            </div>

        </div>


        <!-- Booking -->

        <div class="p-6 border-t">

            <h2 class="text-xl font-bold mb-4">
                Booking Information
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                <div>

                    <p class="text-gray-500">
                        Check In
                    </p>

                    <p class="font-semibold">
                        <%= booking.checkIn.toDateString() %>
                    </p>

                </div>


                <div>

                    <p class="text-gray-500">
                        Check Out
                    </p>

                    <p class="font-semibold">
                        <%= booking.checkOut.toDateString() %>
                    </p>

                </div>


                <div>

                    <p class="text-gray-500">
                        Guests
                    </p>

                    <p class="font-semibold">
                        <%= booking.guests %>
                    </p>

                </div>


                <div>

                    <p class="text-gray-500">
                        Total Price
                    </p>

                    <p class="font-semibold">
                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                    </p>

                </div>

            </div>

        </div>


        <!-- Status -->

        <!-- Booking Status -->

<div class="p-6 border-t">

    <h2 class="text-xl font-bold mb-4">
        Booking Status
    </h2>


    <!-- Pending -->

    <% if (booking.status === "Pending") { %>

        <span class="inline-block bg-yellow-100 text-yellow-700
                     px-4 py-2 rounded-full font-medium">

            ⏳ Pending Approval

        </span>


        <div class="flex flex-wrap gap-3 mt-6">

            <!-- Approve -->

            <form
                action="/host/bookings/<%= booking._id %>/approve"
                method="POST">

                <button
                    type="submit"
                    class="bg-green-500 hover:bg-green-600
                           text-white px-5 py-2 rounded-lg">

                    ✓ Approve Booking

                </button>

            </form>


            <!-- Cancel -->

            <form
                action="/host/bookings/<%= booking._id %>/cancel"
                method="POST"
                onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                <button
                    type="submit"
                    class="bg-red-500 hover:bg-red-600
                           text-white px-5 py-2 rounded-lg">

                    ✕ Cancel Booking

                </button>

            </form>

        </div>


    <!-- Confirmed -->

    <% } else if (booking.status === "Confirmed") { %>

        <span class="inline-block bg-green-100 text-green-700
                     px-4 py-2 rounded-full font-medium">

            ✓ Confirmed

        </span>


        <form
            action="/host/bookings/<%= booking._id %>/cancel"
            method="POST"
            class="mt-6"
            onsubmit="return confirm('Are you sure you want to cancel this booking?');">

            <button
                type="submit"
                class="bg-red-500 hover:bg-red-600
                       text-white px-5 py-2 rounded-lg">

                Cancel Booking

            </button>

        </form>


    <!-- Cancelled -->

    <% } else if (booking.status === "Cancelled") { %>

        <span class="inline-block bg-red-100 text-red-700
                     px-4 py-2 rounded-full font-medium">

            ✕ Cancelled

        </span>

    <% } %>

</div>

    </div>

</main>