<%- include('../partials/head') %>
</head>

<body class="bg-gray-100 font-sans min-h-screen">

    <%- include('../partials/header') %>
    <%- include("../partials/flash") %>


    <!-- ================= SIGNUP SECTION ================= -->

    <main class="flex justify-center items-start px-4 py-8">

        <!-- Signup Card -->
        <div
            class="w-full max-w-md
                   bg-white
                   rounded-xl
                   shadow-md
                   border border-gray-200
                   overflow-hidden">


            <!-- ================= HEADER ================= -->

            <div
                class="text-center
                       px-5 pt-5 pb-4
                       border-b border-gray-100">

                <h1 class="text-xl font-bold text-gray-800">
                    Create Account
                </h1>

                <p class="text-xs text-gray-500 mt-1.5 mb-2">
                    Sign up to get started
                </p>

            </div>


            <!-- ================= SIGNUP FORM ================= -->

            <form
                action="/signup"
                method="POST"
                class="px-5 py-5">

                <!-- ================= ERROR MESSAGES ================= -->

                <%- include('../partials/errors') %>


                <!-- ================= FIRST NAME ================= -->

                <div class="mb-4">

                    <label
                        for="firstName"
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        First Name

                    </label>


                    <input
                        id="firstName"
                        type="text"
                        name="firstName"
                        placeholder="Enter your first name"
                        value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                        required
                        autocomplete="given-name"
                        class="w-full
                               px-3 py-2.5
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2
                               focus:ring-red-100
                               transition duration-200">

                </div>


                <!-- ================= LAST NAME ================= -->

                <div class="mb-4">

                    <label
                        for="lastName"
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        Last Name

                    </label>


                    <input
                        id="lastName"
                        type="text"
                        name="lastName"
                        placeholder="Enter your last name"
                        value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                        required
                        autocomplete="family-name"
                        class="w-full
                               px-3 py-2.5
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2
                               focus:ring-red-100
                               transition duration-200">

                </div>


                <!-- ================= EMAIL ================= -->

                <div class="mb-4">

                    <label
                        for="email"
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        Email Address

                    </label>


                    <input
                        id="email"
                        type="email"
                        name="email"
                        placeholder="you@example.com"
                        value="<%= oldInput.email ? oldInput.email : '' %>"
                        required
                        autocomplete="email"
                        class="w-full
                               px-3 py-2.5
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2
                               focus:ring-red-100
                               transition duration-200">

                </div>


                <!-- ================= PASSWORD ================= -->

                <div class="mb-4">

                    <label
                        for="password"
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        Password

                    </label>


                    <input
                        id="password"
                        type="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                        minlength="6"
                        autocomplete="new-password"
                        class="w-full
                               px-3 py-2.5
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2
                               focus:ring-red-100
                               transition duration-200">


                    <p class="text-xs text-gray-400 mt-1.5">
                        Minimum 6 characters
                    </p>

                </div>


                <!-- ================= CONFIRM PASSWORD ================= -->

                <div class="mb-4">

                    <label
                        for="confirmPassword"
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        Confirm Password

                    </label>


                    <input
                        id="confirmPassword"
                        type="password"
                        name="confirmPassword"
                        placeholder="Confirm your password"
                        required
                        minlength="6"
                        autocomplete="new-password"
                        class="w-full
                               px-3 py-2.5
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2
                               focus:ring-red-100
                               transition duration-200">

                </div>


                <!-- ================= USER TYPE ================= -->

                <div class="mb-4">

                    <label
                        class="block
                               text-sm
                               font-semibold
                               text-gray-700
                               mb-2">

                        Register as

                    </label>


                    <div class="grid grid-cols-2 gap-2">

                        <!-- Guest -->

                        <label
                            class="flex items-center gap-2
                                   border border-gray-300
                                   rounded-lg
                                   px-3 py-2.5
                                   cursor-pointer
                                   hover:border-red-400
                                   hover:bg-red-50
                                   transition">

                            <input
                                type="radio"
                                name="userType"
                                value="guest"
                                id="guest"
                                required
                                class="w-4 h-4 accent-red-500"
                                <%= oldInput.userType === "guest"
                                    ? "checked"
                                    : "" %>>

                            <span class="text-sm text-gray-700">
                                Guest
                            </span>

                        </label>


                        <!-- Host -->

                        <label
                            class="flex items-center gap-2
                                   border border-gray-300
                                   rounded-lg
                                   px-3 py-2.5
                                   cursor-pointer
                                   hover:border-red-400
                                   hover:bg-red-50
                                   transition">

                            <input
                                type="radio"
                                name="userType"
                                value="host"
                                id="host"
                                class="w-4 h-4 accent-red-500"
                                <%= oldInput.userType === "host"
                                    ? "checked"
                                    : "" %>>

                            <span class="text-sm text-gray-700">
                                Host
                            </span>

                        </label>

                    </div>

                </div>


                <!-- ================= TERMS ================= -->

                <div
                    class="mb-5
                           flex items-start
                           gap-2">

                    <input
                        id="terms"
                        type="checkbox"
                        name="terms"
                        value="accepted"
                        required
                        class="mt-0.5
                               w-4 h-4
                               accent-red-500
                               shrink-0">


                    <label
                        for="terms"
                        class="text-xs
                               text-gray-600
                               leading-5">

                        I agree to the

                        <a
                            href="#"
                            class="text-red-500
                                   font-medium
                                   hover:underline">

                            Terms & Conditions

                        </a>

                        and

                        <a
                            href="#"
                            class="text-red-500
                                   font-medium
                                   hover:underline">

                            Privacy Policy

                        </a>.

                    </label>

                </div>


                <!-- ================= CREATE ACCOUNT ================= -->

                <button
                    type="submit"
                    class="w-full
                           bg-red-500
                           hover:bg-red-600
                           active:scale-[0.98]
                           text-white
                           py-2.5
                           rounded-lg
                           font-semibold
                           text-sm
                           shadow-sm
                           hover:shadow-md
                           transition-all duration-200">

                    Create Account

                </button>


            </form>


            <!-- ================= LOGIN ================= -->

            <div
                class="text-center
                       px-5 py-4
                       border-t border-gray-100">

                <p class="text-xs text-gray-500">
                    Already have an account?
                </p>


                <a
                    href="/login"
                    class="inline-block
                           mt-1
                           text-sm
                           text-red-500
                           font-semibold
                           hover:text-red-600
                           hover:underline
                           transition">

                    Login

                </a>

            </div>


        </div>

    </main>


</body>

</html>