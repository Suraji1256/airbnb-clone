<%- include('../partials/head') %>
</head>

<body class="bg-gray-100 font-sans min-h-screen">

    <%- include('../partials/header') %>
    <%- include("../partials/flash") %>

    <!-- Login Section -->
    <main class="flex justify-center items-start px-4 py-12">

        <!-- Login Card -->
        <div class="w-full max-w-md bg-white rounded-2xl shadow-lg border border-gray-200 p-8">

            <!-- Heading -->
            <div class="text-center mb-8">

                <h1 class="text-3xl font-bold text-gray-800">
                    Login
                </h1>

                <p class="text-sm text-gray-500 mt-2">
                    Login with your account details
                </p>

            </div>


            <!-- Login Form -->
            <form action="/login" method="POST" class="space-y-5">

                <!-- ================= Error Messages ================= -->
                <%- include('../partials/errors') %>

                <!-- Username -->
                <div>

                    <label
                        for="email"
                        class="block text-sm font-semibold text-gray-700 mb-2">
                        Email
                    </label>

                    <input
                        id="email"
                        type="email"
                        name="email"
                        placeholder="Enter your email"
                        value="<%= oldInput.email ? oldInput.email : '' %>"
                        required
                        autocomplete="email"
                        class="w-full px-4 py-3
                               bg-white
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2 focus:ring-red-100
                               transition duration-200 mb-4">

                </div>


                <!-- Password -->
                <div>

                    <label
                        for="password"
                        class="block text-sm font-semibold text-gray-700 mb-2">
                        Password
                    </label>

                    <input
                        id="password"
                        type="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                        autocomplete="current-password"
                        class="w-full px-4 py-3
                               bg-white
                               border border-gray-300
                               rounded-lg
                               text-sm text-gray-800
                               placeholder-gray-400
                               outline-none
                               focus:border-red-500
                               focus:ring-2 focus:ring-red-100
                               transition duration-200 mb-4">

                </div>


                <!-- Remember + Forgot -->
                <div class="flex items-center justify-between pt-3 mb-4">

                    <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">

                        <input
                            type="checkbox"
                            name="remember"
                            class="w-4 h-4 accent-red-500">

                        <span>Remember me</span>

                    </label>

                    <a
                        href="#"
                        class="text-sm text-red-500 hover:text-red-600 hover:underline">
                        Forgot password?
                    </a>

                </div>


                <!-- Login Button -->
                <input
                    type="submit" value="Sign In"
                    class="w-full bg-red-500
                           hover:bg-red-600
                           active:scale-[0.98]
                           text-white
                           py-3
                           rounded-lg
                           font-semibold
                           shadow-sm
                           hover:shadow-md
                           transition-all duration-200">

            </input>

            </form>


            <!-- Register Section -->
            <div class="text-center mt-7 pt-6 border-t border-gray-200">

                <p class="text-sm text-gray-500">
                    Don't have an account?
                </p>

                <a
                    href="/signup"
                    class="inline-block mt-2
                           text-red-500
                           font-semibold
                           text-sm
                           hover:text-red-600
                           hover:underline
                           transition">

                    Create an account

                </a>

            </div>

        </div>

    </main>

</body>
</html>