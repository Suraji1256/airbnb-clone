<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50
             flex items-center justify-center px-4 py-10">

    <div class="bg-white w-full max-w-md
                rounded-2xl shadow-lg p-8">

        <div class="text-center">

            <div class="text-5xl mb-4">
                💳
            </div>

            <h1 class="text-2xl font-bold">
                Complete Your Payment
            </h1>

            <p class="text-gray-500 mt-2">
                <%= booking.home.houseName %>
            </p>

        </div>


        <div class="border rounded-xl p-5 mt-6">

            <div class="flex justify-between">

                <span class="text-gray-500">
                    Booking Amount
                </span>

                <span class="font-bold">
                    ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                </span>

            </div>


            <div class="flex justify-between mt-3">

                <span class="text-gray-500">
                    Guests
                </span>

                <span>
                    <%= booking.guests %>
                </span>

            </div>


            <div class="flex justify-between mt-3">

                <span class="text-gray-500">
                    Check In
                </span>

                <span>
                    <%= booking.checkIn.toDateString() %>
                </span>

            </div>


            <div class="flex justify-between mt-3">

                <span class="text-gray-500">
                    Check Out
                </span>

                <span>
                    <%= booking.checkOut.toDateString() %>
                </span>

            </div>

        </div>


        <button
            id="pay-button"
            class="w-full mt-6 bg-red-500
                   hover:bg-red-600 text-white
                   py-3 rounded-xl font-semibold">

            Pay ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

        </button>

    </div>

</main>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<script>

    const options = {

        key: "<%= razorpayKeyId %>",

        amount: "<%= amount %>",

        currency: "INR",

        name: "Airbnb Clone",

        description: "Booking Payment",

        order_id: "<%= razorpayOrderId %>",


        handler: async function (response) {

            try {

                const result = await fetch(
                    "/payment/verify",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({

                            bookingId:
                                "<%= booking._id %>",

                            razorpay_payment_id:
                                response.razorpay_payment_id,

                            razorpay_order_id:
                                response.razorpay_order_id,

                            razorpay_signature:
                                response.razorpay_signature

                        })

                    }
                );


                const data = await result.json();


                if (data.success) {

                    window.location.href =
                        "/bookings";

                } else {

                    alert(
                        "Payment verification failed."
                    );

                }

            } catch (error) {

                console.error(error);

                alert(
                    "Something went wrong while verifying payment."
                );

            }

        },


        theme: {
            color: "#ef4444"
        }

    };


    const razorpay =
        new Razorpay(options);


    document
        .getElementById("pay-button")
        .onclick = function (e) {

            razorpay.open();

            e.preventDefault();

        };

</script>