<%- include("../partials/head") %>
<%- include("../partials/header") %>

<% if (typeof queryError !== "undefined" && queryError) { %>

    <div class="mb-6 bg-red-50 border border-red-200
                text-red-700 px-5 py-4 rounded-xl">

        <% if (queryError === "activeBooking") { %>

            <p class="font-semibold">
                Property cannot be removed.
            </p>

            <p class="text-sm mt-1">
                This property has an active or upcoming booking.
            </p>

        <% } else if (queryError === "homeNotFound") { %>

            <p class="font-semibold">
                Property not found.
            </p>

        <% } %>

    </div>

<% } %>


<% if (
    typeof querySuccess !== "undefined" &&
    querySuccess === "homeDeleted"
) { %>

    <div class="mb-6 bg-green-50 border border-green-200
                text-green-700 px-5 py-4 rounded-xl">

        <p class="font-semibold">
            Property removed successfully.
        </p>

    </div>

<% } %>

<main class="max-w-7xl mx-auto px-4 py-8">

    <!-- Header -->

    <div class="mb-8">

        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
            Manage Properties
        </h1>

        <p class="text-gray-500 mt-2">
            View and manage all properties listed on the platform.
        </p>

    </div>


    <!-- Properties -->

    <div class="bg-white rounded-2xl shadow-md overflow-hidden">

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-gray-50 border-b">

                    <tr>

                        <th class="text-left p-4">
                            Property
                        </th>

                        <th class="text-left p-4">
                            Host
                        </th>

                        <th class="text-left p-4">
                            Location
                        </th>

                        <th class="text-left p-4">
                            Price
                        </th>

                        <th class="text-left p-4">
                            Type
                        </th>

                        <th class="text-left p-4">
                            Rating
                        </th>

                        <th class="text-left p-4">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (homes.length === 0) { %>

                        <tr>

                            <td
                                colspan="7"
                                class="p-10 text-center text-gray-500">

                                No properties found.

                            </td>

                        </tr>

                    <% } %>


                    <% homes.forEach(home => { %>

                        <tr class="border-b hover:bg-gray-50">

                            <!-- Property -->

                            <td class="p-4">

                                <div class="flex items-center gap-3">

                                    <img
                                        src="<%= home.photo %>"
                                        alt="<%= home.houseName %>"
                                        class="w-16 h-12 object-cover rounded-lg">

                                    <div>

                                        <p class="font-semibold text-gray-800">

                                            <%= home.houseName %>

                                        </p>

                                        <p class="text-sm text-gray-500">

                                            <%= home.description
                                                ? home.description.substring(0, 40)
                                                : "No description" %>...

                                        </p>

                                    </div>

                                </div>

                            </td>


                            <!-- Host -->

                            <td class="p-4">

                                <% if (home.owner) { %>

                                    <p class="font-medium">

                                        <%= home.owner.name %>

                                    </p>

                                    <p class="text-sm text-gray-500">

                                        <%= home.owner.email %>

                                    </p>

                                <% } else { %>

                                    <span class="text-red-500">

                                        Unknown Host

                                    </span>

                                <% } %>

                            </td>


                            <!-- Location -->

                            <td class="p-4 text-gray-600">

                                📍 <%= home.location %>

                            </td>


                            <!-- Price -->

                            <td class="p-4 font-semibold">

                                ₹<%= home.price %>

                                <span class="text-sm text-gray-400">
                                    /night
                                </span>

                            </td>


                            <!-- Property Type -->

                            <td class="p-4">

                                <span
                                    class="bg-gray-100
                                           text-gray-700
                                           px-3 py-1
                                           rounded-full
                                           text-sm">

                                    <%= home.propertyType %>

                                </span>

                            </td>


                            <!-- Rating -->

                            <td class="p-4">

                                <span class="text-yellow-500">

                                    ★

                                </span>

                                <%= home.averageRating || 0 %>

                                <span class="text-gray-400 text-sm">

                                    (<%= home.reviewCount || 0 %>)

                                </span>

                            </td>


                            <!-- Action -->

                            <td class="p-4">

    <div class="flex flex-wrap gap-2">

        <!-- View -->

        <a
            href="/homes/<%= home._id %>"
            class="inline-block
                   bg-gray-900
                   hover:bg-gray-700
                   text-white
                   px-3 py-2
                   rounded-lg
                   text-sm">

            View

        </a>


        <!-- Delete -->

        <form
            action="/admin/homes/<%= home._id %>/delete"
            method="POST"
            onsubmit="return confirm('Are you sure you want to remove this property?');">

            <button
                type="submit"
                class="bg-red-500
                       hover:bg-red-600
                       text-white
                       px-3 py-2
                       rounded-lg
                       text-sm">

                🗑 Delete

            </button>

        </form>

    </div>

</td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</main>