<%- include("../partials/head") %>
<%- include("../partials/header") %>

<style>
    /* Hide scrollbar but keep horizontal scrolling */
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>

<main class="bg-gray-50 min-h-screen px-4 sm:px-6 lg:px-8 py-8">

    <div class="max-w-[1800px] mx-auto">

        <!-- ================= HEADER ================= -->

        <div class="mb-8">

            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">

                <div>

                    <div class="flex items-center gap-3 mb-2">

                        <div
                            class="w-11 h-11 rounded-xl
                                   bg-rose-100
                                   flex items-center justify-center">

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.8"
                                stroke="currentColor"
                                class="w-6 h-6 text-rose-500">

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6.75 3.75h10.5A2.25 2.25 0 0 1 19.5 6v12a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 18V6a2.25 2.25 0 0 1 2.25-2.25Z" />

                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M8.25 7.5h7.5M8.25 11.25h7.5M8.25 15h4.5" />

                            </svg>

                        </div>

                        <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
                            Manage Bookings
                        </h1>

                    </div>

                    <p class="text-gray-500">
                        View and manage all bookings on the platform.
                    </p>

                </div>


                <!-- Booking Count -->

                <div
                    class="inline-flex items-center gap-2
                           bg-white
                           border border-gray-200
                           rounded-xl
                           px-4 py-3
                           shadow-sm
                           self-start sm:self-auto">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.8"
                        stroke="currentColor"
                        class="w-5 h-5 text-gray-500">

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6.75 3.75h10.5A2.25 2.25 0 0 1 19.5 6v12a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 18V6a2.25 2.25 0 0 1 2.25-2.25Z" />

                    </svg>

                    <span class="text-sm text-gray-500">
                        Total Bookings
                    </span>

                    <span class="font-bold text-gray-900">
                        <%= bookings.length %>
                    </span>

                </div>

            </div>

        </div>


        <!-- ================= BOOKING TABLE ================= -->

        <div
            class="bg-white
                   rounded-2xl
                   border border-gray-200
                   shadow-sm
                   overflow-hidden">

            <!-- Table Header -->

            <div
                class="px-6 py-4
                       border-b border-gray-200
                       bg-white
                       flex items-center justify-between">

                <div>

                    <h2 class="font-semibold text-gray-900">
                        All Bookings
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Complete booking information
                    </p>

                </div>

            </div>


            <!-- Scroll Container -->

            <div
                class="overflow-x-auto
                       hide-scrollbar">

                <table class="w-full min-w-[1650px] border-collapse">

                    <!-- ================= TABLE HEAD ================= -->

                    <thead>

                        <tr
                            class="bg-gray-50
                                   border-b border-gray-200
                                   text-xs
                                   uppercase
                                   tracking-wider
                                   text-gray-500">

                            <th class="text-left px-6 py-4 font-semibold">
                                Guest
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Property
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Host
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Check In
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Check Out
                            </th>

                            <th class="text-center px-6 py-4 font-semibold">
                                Guests
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Total
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Status
                            </th>

                            <th class="text-left px-6 py-4 font-semibold">
                                Created
                            </th>

                            <th class="text-center px-6 py-4 font-semibold">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <!-- ================= TABLE BODY ================= -->

                    <tbody class="divide-y divide-gray-100">

                        <% if (bookings.length === 0) { %>

                            <tr>

                                <td
                                    colspan="10"
                                    class="px-6 py-16 text-center">

                                    <div class="flex flex-col items-center">

                                        <div
                                            class="w-16 h-16
                                                   rounded-full
                                                   bg-gray-100
                                                   flex items-center justify-center
                                                   mb-4">

                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke-width="1.8"
                                                stroke="currentColor"
                                                class="w-8 h-8 text-gray-400">

                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M6.75 3.75h10.5A2.25 2.25 0 0 1 19.5 6v12a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 18V6a2.25 2.25 0 0 1 2.25-2.25Z" />

                                            </svg>

                                        </div>

                                        <h3 class="font-semibold text-gray-900">
                                            No bookings found
                                        </h3>

                                        <p class="text-sm text-gray-500 mt-1">
                                            There are currently no bookings to display.
                                        </p>

                                    </div>

                                </td>

                            </tr>

                        <% } %>


                        <% bookings.forEach(booking => { %>

                            <tr
                                class="group
                                       hover:bg-gray-50
                                       transition-colors
                                       duration-200">


                                <!-- ================= GUEST ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <% if (booking.user) { %>

                                        <div class="flex items-center gap-3">

                                            <div
                                                class="w-10 h-10
                                                       rounded-full
                                                       bg-rose-100
                                                       text-rose-600
                                                       flex items-center justify-center
                                                       font-semibold">

                                                <%= booking.user.name
                                                    ? booking.user.name.charAt(0).toUpperCase()
                                                    : "U" %>

                                            </div>

                                            <div>

                                                <p class="font-semibold text-gray-900">
                                                    <%= booking.user.name %>
                                                </p>

                                                <p class="text-sm text-gray-500">
                                                    <%= booking.user.email %>
                                                </p>

                                            </div>

                                        </div>

                                    <% } else { %>

                                        <span
                                            class="inline-flex items-center
                                                   rounded-lg
                                                   bg-red-50
                                                   text-red-600
                                                   px-3 py-2
                                                   text-sm">

                                            User deleted

                                        </span>

                                    <% } %>

                                </td>


                                <!-- ================= PROPERTY ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <% if (booking.home) { %>

                                        <div>

                                            <p class="font-semibold text-gray-900">
                                                <%= booking.home.houseName %>
                                            </p>

                                            <div
                                                class="flex items-center gap-1
                                                       text-sm text-gray-500 mt-1">

                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke-width="1.8"
                                                    stroke="currentColor"
                                                    class="w-4 h-4">

                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />

                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        d="M19.5 10.5c0 7.142-7.5 11-7.5 11s-7.5-3.858-7.5-11a7.5 7.5 0 1 1 15 0Z" />

                                                </svg>

                                                <%= booking.home.location %>

                                            </div>

                                        </div>

                                    <% } else { %>

                                        <span class="text-red-500">
                                            Property deleted
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ================= HOST ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <% if (
                                        booking.home &&
                                        booking.home.owner
                                    ) { %>

                                        <div>

                                            <p class="font-medium text-gray-900">
                                                <%= booking.home.owner.name %>
                                            </p>

                                            <p class="text-sm text-gray-500">
                                                <%= booking.home.owner.email %>
                                            </p>

                                        </div>

                                    <% } else { %>

                                        <span class="text-gray-400">
                                            N/A
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ================= CHECK IN ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <div>

                                        <p class="font-medium text-gray-900">
                                            <%= booking.checkIn.toDateString() %>
                                        </p>

                                        <p class="text-xs text-gray-400 mt-1">
                                            Check-in
                                        </p>

                                    </div>

                                </td>


                                <!-- ================= CHECK OUT ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <div>

                                        <p class="font-medium text-gray-900">
                                            <%= booking.checkOut.toDateString() %>
                                        </p>

                                        <p class="text-xs text-gray-400 mt-1">
                                            Check-out
                                        </p>

                                    </div>

                                </td>


                                <!-- ================= GUEST COUNT ================= -->

                                <td class="px-6 py-5 whitespace-nowrap text-center">

                                    <div
                                        class="inline-flex items-center gap-2
                                               rounded-lg
                                               bg-gray-100
                                               px-3 py-2">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.8"
                                            stroke="currentColor"
                                            class="w-4 h-4 text-gray-500">

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.125-.942M15 19.128v-.003c0-1.053.482-2.06 1.318-2.716a4.5 4.5 0 0 0-7.008 0A3.5 3.5 0 0 0 10.5 19.125v.003M15 19.128a9.38 9.38 0 0 1-4.5 0M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z" />

                                        </svg>

                                        <span class="font-semibold text-gray-700">
                                            <%= booking.guests %>
                                        </span>

                                    </div>

                                </td>


                                <!-- ================= TOTAL ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <p class="text-lg font-bold text-gray-900">

                                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                                    </p>

                                </td>


                                <!-- ================= STATUS ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <% if (booking.status === "Confirmed") { %>

                                        <span
                                            class="inline-flex items-center gap-2
                                                   bg-green-50
                                                   text-green-700
                                                   border border-green-200
                                                   px-3 py-1.5
                                                   rounded-full
                                                   text-sm
                                                   font-medium">

                                            <span class="w-2 h-2 rounded-full bg-green-500"></span>

                                            Confirmed

                                        </span>

                                    <% } else if (
                                        booking.status === "Cancelled"
                                    ) { %>

                                        <span
                                            class="inline-flex items-center gap-2
                                                   bg-red-50
                                                   text-red-700
                                                   border border-red-200
                                                   px-3 py-1.5
                                                   rounded-full
                                                   text-sm
                                                   font-medium">

                                            <span class="w-2 h-2 rounded-full bg-red-500"></span>

                                            Cancelled

                                        </span>

                                    <% } else { %>

                                        <span
                                            class="inline-flex items-center gap-2
                                                   bg-yellow-50
                                                   text-yellow-700
                                                   border border-yellow-200
                                                   px-3 py-1.5
                                                   rounded-full
                                                   text-sm
                                                   font-medium">

                                            <span class="w-2 h-2 rounded-full bg-yellow-500"></span>

                                            <%= booking.status %>

                                        </span>

                                    <% } %>

                                </td>


                                <!-- ================= CREATED ================= -->

                                <td class="px-6 py-5 whitespace-nowrap">

                                    <p class="font-medium text-gray-700">

                                        <%= booking.createdAt
                                            ? booking.createdAt.toDateString()
                                            : "N/A" %>

                                    </p>

                                </td>


                                <!-- ================= ACTION ================= -->

                                <td class="px-6 py-5 whitespace-nowrap text-center">

                                    <a
                                        href="/admin/bookings/<%= booking._id %>"
                                        class="inline-flex items-center justify-center gap-2
                                               bg-gray-900
                                               hover:bg-rose-500
                                               text-white
                                               px-4 py-2.5
                                               rounded-xl
                                               text-sm
                                               font-semibold
                                               shadow-sm
                                               hover:shadow-md
                                               transition-all
                                               duration-200">

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.8"
                                            stroke="currentColor"
                                            class="w-4 h-4">

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12s-3.75 6.75-9.75 6.75S2.25 12 2.25 12Z" />

                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />

                                        </svg>

                                        View

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</main>