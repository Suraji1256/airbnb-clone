<%- include("../partials/head") %>
<%- include("../partials/header") %>

<% if (typeof queryError !== "undefined" && queryError) { %>

    <div class="mb-6 bg-red-50 border border-red-200
                text-red-700 px-5 py-4 rounded-xl">

        <% if (queryError === "ownsProperty") { %>

            <p class="font-semibold">
                Cannot delete this user.
            </p>

            <p class="text-sm mt-1">
                This user owns one or more properties.
                Transfer or remove those properties first.
            </p>

        <% } else if (queryError === "activeBooking") { %>

            <p class="font-semibold">
                Cannot delete this user.
            </p>

            <p class="text-sm mt-1">
                This user has an active or upcoming booking.
            </p>

        <% } else if (queryError === "userNotFound") { %>

            <p class="font-semibold">
                User not found.
            </p>

        <% } %>

    </div>

<% } %>


<% if (typeof querySuccess !== "undefined" && querySuccess === "userDeleted") { %>

    <div class="mb-6 bg-green-50 border border-green-200
                text-green-700 px-5 py-4 rounded-xl">

        <p class="font-semibold">
            User deleted successfully.
        </p>

    </div>

<% } %>

<main class="max-w-7xl mx-auto px-4 py-8">

    <!-- Header -->

    <div class="mb-8">

        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
            Manage Users
        </h1>

        <p class="text-gray-500 mt-2">
            View all registered users on the platform.
        </p>

        <p class="text-sm text-gray-500 mt-3">
            <%= users.length %>
            user<%= users.length === 1 ? "" : "s" %> found
        </p>

    </div>

    <!-- Search & Filters -->

<div class="bg-white rounded-2xl shadow-md p-5 mb-6">

    <form
        action="/admin/users"
        method="GET"
        class="grid grid-cols-1 md:grid-cols-4 gap-4">


        <!-- Search -->

        <div class="md:col-span-2">

            <label
                class="block text-sm font-medium
                       text-gray-700 mb-2">

                Search User

            </label>

            <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Name or email..."

                class="w-full border border-gray-300
                       rounded-lg px-4 py-2.5
                       focus:ring-2 focus:ring-red-400
                       focus:outline-none"
            >

        </div>


        <!-- User Type -->

        <div>

            <label
                class="block text-sm font-medium
                       text-gray-700 mb-2">

                User Type

            </label>

            <select
                name="userType"
                class="w-full border border-gray-300
                       rounded-lg px-4 py-2.5
                       focus:ring-2 focus:ring-red-400
                       focus:outline-none">

                <option value="">
                    All Users
                </option>

                <option
                    value="guest"
                    <%= userType === "guest"
                        ? "selected"
                        : "" %>>

                    Guest

                </option>

                <option
                    value="host"
                    <%= userType === "host"
                        ? "selected"
                        : "" %>>

                    Host

                </option>

                <option
                    value="admin"
                    <%= userType === "admin"
                        ? "selected"
                        : "" %>>

                    Admin

                </option>

            </select>

        </div>


        <!-- Sort -->

        <div>

            <label
                class="block text-sm font-medium
                       text-gray-700 mb-2">

                Sort By

            </label>

            <select
                name="sort"
                class="w-full border border-gray-300
                       rounded-lg px-4 py-2.5
                       focus:ring-2 focus:ring-red-400
                       focus:outline-none">

                <option
                    value="newest"
                    <%= sort === "newest"
                        ? "selected"
                        : "" %>>

                    Newest

                </option>

                <option
                    value="oldest"
                    <%= sort === "oldest"
                        ? "selected"
                        : "" %>>

                    Oldest

                </option>

                <option
                    value="name"
                    <%= sort === "name"
                        ? "selected"
                        : "" %>>

                    Name A-Z

                </option>

            </select>

        </div>


        <!-- Buttons -->

        <div class="md:col-span-4 flex flex-wrap gap-3">

            <button
                type="submit"
                class="bg-red-500 hover:bg-red-600
                       text-white px-6 py-2.5
                       rounded-lg font-medium">

                🔎 Search

            </button>


            <a
                href="/admin/users"
                class="bg-gray-100 hover:bg-gray-200
                       text-gray-700 px-6 py-2.5
                       rounded-lg font-medium">

                Reset

            </a>

        </div>

    </form>

</div>


    <!-- Users -->

    <div class="bg-white rounded-2xl shadow-md overflow-hidden">

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-gray-50 border-b">

                    <tr>

                        <th class="text-left p-4">
                            Name
                        </th>

                        <th class="text-left p-4">
                            Email
                        </th>

                        <th class="text-left p-4">
                            User Type
                        </th>

                        <th class="text-left p-4">
                            Joined
                        </th>

                        <th class="text-left p-4">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% users.forEach(account => { %>

                        <tr class="border-b hover:bg-gray-50">

                            <td class="p-4 font-medium">

                                <%= account.firstName %>
                                <%= account.lastName || "" %>

                            </td>


                            <td class="p-4 text-gray-600">

                                <%= account.email %>

                            </td>


                            <td class="p-4">

                                <% if (account.userType === "admin") { %>

                                    <span class="bg-purple-100 text-purple-700
                                                 px-3 py-1 rounded-full text-sm">

                                        Admin

                                    </span>

                                <% } else if (account.userType === "host") { %>

                                    <span class="bg-blue-100 text-blue-700
                                                 px-3 py-1 rounded-full text-sm">

                                        Host

                                    </span>

                                <% } else { %>

                                    <span class="bg-gray-100 text-gray-700
                                                 px-3 py-1 rounded-full text-sm">

                                        Guest

                                    </span>

                                <% } %>

                            </td>


                            <td class="p-4 text-gray-600">

                                <%= account.createdAt
                                ? new Date(account.createdAt)
                                .toLocaleDateString("en-IN")
                                : "N/A"
                                 %>

                            </td>


<td class="p-4">

    <% if (
        account._id.toString() ===
        user.id.toString()
    ) { %>

        <span class="text-gray-400 text-sm">
            Current Admin
        </span>

    <% } else { %>

        <div class="flex flex-wrap items-center gap-2">

            <a
                href="/admin/users/<%= account._id %>"
                class="bg-blue-500 hover:bg-blue-600
              text-white px-3 py-2
                rounded-lg text-sm">

                    View

            </a>

            <!-- Change User Type -->

            <form
                action="/admin/users/<%= account._id %>/change-type"
                method="POST"
                class="flex items-center gap-2">

                <select
                    name="userType"
                    class="border border-gray-300
                           rounded-lg px-3 py-2
                           text-sm">

                    <option
                        value="guest"
                        <%= account.userType === "guest"
                            ? "selected"
                            : "" %>>

                        Guest

                    </option>

                    <option
                        value="host"
                        <%= account.userType === "host"
                            ? "selected"
                            : "" %>>

                        Host

                    </option>

                </select>

                <button
                    type="submit"
                    class="bg-gray-900 hover:bg-gray-700
                           text-white px-3 py-2
                           rounded-lg text-sm">

                    Update

                </button>

            </form>


            <!-- Delete User -->

            <form
                action="/admin/users/<%= account._id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this user?');">

                <button
                    type="submit"
                    class="bg-red-500 hover:bg-red-600
                           text-white px-3 py-2
                           rounded-lg text-sm">

                    🗑 Delete

                </button>

            </form>

        </div>

    <% } %>

</td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</main>