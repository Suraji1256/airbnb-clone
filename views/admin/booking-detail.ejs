<%- include("../partials/head") %>
<%- include("../partials/header") %>

<% if (typeof queryError !== "undefined" && queryError) { %>

    <div class="max-w-5xl mx-auto mb-6">

        <div class="bg-red-50 border border-red-200
                    text-red-700 px-5 py-4 rounded-xl">

            <% if (queryError === "alreadyCancelled") { %>

                <p class="font-semibold">
                    This booking is already cancelled.
                </p>

            <% } else if (queryError === "invalidStatus") { %>

                <p class="font-semibold">
                    This booking cannot be cancelled.
                </p>

            <% } else { %>

                <p class="font-semibold">
                    Something went wrong.
                </p>

            <% } %>

        </div>

    </div>

<% } %>


<% if (
    typeof querySuccess !== "undefined" &&
    querySuccess === "bookingCancelled"
) { %>

    <div class="max-w-5xl mx-auto mb-6">

        <div class="bg-green-50 border border-green-200
                    text-green-700 px-5 py-4 rounded-xl">

            <p class="font-semibold">
                Booking cancelled successfully.
            </p>

        </div>

    </div>

<% } %>

<main class="max-w-5xl mx-auto px-4 py-8">

    <!-- Back -->

    <a
        href="/admin/bookings"
        class="inline-flex items-center gap-2
               text-gray-600 hover:text-gray-900 mb-6">

        ← Back to Bookings

    </a>


    <!-- Header -->

    <div class="mb-8">

        <h1 class="text-3xl font-bold text-gray-800">
            Booking Details
        </h1>

        <p class="text-gray-500 mt-2">
            Booking ID:
            <span class="font-mono">
                <%= booking._id %>
            </span>
        </p>

    </div>


    <!-- Main Card -->

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">


        <!-- Property -->

        <% if (booking.home) { %>

            <div class="md:flex">

                <div class="md:w-1/3">

                    <img
                        src="<%= booking.home.photo %>"
                        alt="<%= booking.home.houseName %>"
                        class="w-full h-64 md:h-full object-cover">

                </div>


                <div class="p-6 md:w-2/3">

                    <p class="text-sm text-gray-500">
                        Property
                    </p>

                    <h2 class="text-2xl font-bold text-gray-800 mt-1">

                        <%= booking.home.houseName %>

                    </h2>

                    <p class="text-gray-600 mt-2">

                        📍 <%= booking.home.location %>

                    </p>

                    <p class="text-gray-500 mt-2">

                        <%= booking.home.propertyType %>

                    </p>

                </div>

            </div>

        <% } else { %>

            <div class="p-6 bg-red-50 text-red-700">

                This property is no longer available.

            </div>

        <% } %>


        <!-- Booking Information -->

        <div class="p-6 border-t">

            <h2 class="text-xl font-semibold mb-5">
                Booking Information
            </h2>


            <div class="grid grid-cols-1
                        sm:grid-cols-2
                        lg:grid-cols-3
                        gap-6">


                <!-- Check In -->

                <div>

                    <p class="text-sm text-gray-500">
                        Check In
                    </p>

                    <p class="font-semibold mt-1">

                        <%= booking.checkIn.toDateString() %>

                    </p>

                </div>


                <!-- Check Out -->

                <div>

                    <p class="text-sm text-gray-500">
                        Check Out
                    </p>

                    <p class="font-semibold mt-1">

                        <%= booking.checkOut.toDateString() %>

                    </p>

                </div>


                <!-- Guests -->

                <div>

                    <p class="text-sm text-gray-500">
                        Guests
                    </p>

                    <p class="font-semibold mt-1">

                        <%= booking.guests %>

                    </p>

                </div>


                <!-- Total -->

                <div>

                    <p class="text-sm text-gray-500">
                        Total Price
                    </p>

                    <p class="font-semibold text-lg mt-1">

                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                    </p>

                </div>


                <!-- Status -->

                <div>

                    <p class="text-sm text-gray-500">
                        Status
                    </p>

                    <div class="mt-2">

                        <% if (booking.status === "Confirmed") { %>

                            <span
                                class="bg-green-100
                                       text-green-700
                                       px-4 py-2
                                       rounded-full
                                       text-sm">

                                ✓ Confirmed

                            </span>

                        <% } else { %>

                            <span
                                class="bg-red-100
                                       text-red-700
                                       px-4 py-2
                                       rounded-full
                                       text-sm">

                                ✕ Cancelled

                            </span>

                        <% } %>

                    </div>

                </div>


                <!-- Created -->

                <div>

                    <p class="text-sm text-gray-500">
                        Booked On
                    </p>

                    <p class="font-semibold mt-1">

                        <%= booking.createdAt.toDateString() %>

                    </p>

                </div>

            </div>

        </div>


        <!-- Guest -->

        <div class="p-6 border-t">

            <h2 class="text-xl font-semibold mb-5">
                Guest Details
            </h2>

            <% if (booking.user) { %>

                <div class="bg-gray-50 rounded-xl p-5">

                    <p class="font-semibold text-lg">

                        <%= booking.user.name %>

                    </p>

                    <p class="text-gray-600 mt-1">

                        <%= booking.user.email %>

                    </p>

                </div>

            <% } else { %>

                <p class="text-red-500">
                    Guest account no longer exists.
                </p>

            <% } %>

        </div>


        <!-- Host -->

        <div class="p-6 border-t">

            <h2 class="text-xl font-semibold mb-5">
                Host Details
            </h2>

            <% if (
                booking.home &&
                booking.home.owner
            ) { %>

                <div class="bg-gray-50 rounded-xl p-5">

                    <p class="font-semibold text-lg">

                        <%= booking.home.owner.name %>

                    </p>

                    <p class="text-gray-600 mt-1">

                        <%= booking.home.owner.email %>

                    </p>

                </div>

            <% } else { %>

                <p class="text-gray-500">
                    Host information unavailable.
                </p>

            <% } %>

        </div>


        <!-- Actions -->

        <div class="p-6 border-t flex flex-wrap gap-3">

            <a
                href="/admin/bookings"
                class="bg-gray-100
                       hover:bg-gray-200
                       text-gray-800
                       px-5 py-3
                       rounded-lg">

                Back to Bookings

            </a>


            <% if (booking.status === "Confirmed") { %>

                <form
                    action="/admin/bookings/<%= booking._id %>/cancel"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                    <button
                        type="submit"
                        class="bg-red-500
                               hover:bg-red-600
                               text-white
                               px-5 py-3
                               rounded-lg">

                        Cancel Booking

                    </button>

                </form>

            <% } %>

        </div>

    </div>

</main>