<%- include("../partials/head") %>
<%- include("../partials/header") %>

<main class="max-w-6xl mx-auto px-4 py-8">

    <!-- Back -->

    <a
        href="/admin/users"
        class="inline-flex items-center
               text-gray-600 hover:text-gray-900
               mb-6">

        ← Back to Users

    </a>


    <!-- Page Heading -->

    <div class="mb-8">

        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
            User Details
        </h1>

        <p class="text-gray-500 mt-2">
            View complete information about this user.
        </p>

    </div>


    <!-- User Information -->

    <div class="bg-white rounded-2xl shadow-md p-6 md:p-8">

        <div class="flex flex-col md:flex-row
                    md:items-center md:justify-between
                    gap-5">

            <div>

                <h2 class="text-2xl font-bold text-gray-800">

                    <%= selectedUser.firstName %>

                    <%= selectedUser.lastName || "" %>

                </h2>

                <p class="text-gray-500 mt-1">

                    <%= selectedUser.email %>

                </p>

            </div>


            <!-- Role -->

            <div>

                <% if (selectedUser.userType === "admin") { %>

                    <span
                        class="bg-purple-100 text-purple-700
                               px-4 py-2 rounded-full text-sm font-medium">

                        Admin

                    </span>

                <% } else if (selectedUser.userType === "host") { %>

                    <span
                        class="bg-blue-100 text-blue-700
                               px-4 py-2 rounded-full text-sm font-medium">

                        Host

                    </span>

                <% } else { %>

                    <span
                        class="bg-gray-100 text-gray-700
                               px-4 py-2 rounded-full text-sm font-medium">

                        Guest

                    </span>

                <% } %>

            </div>

        </div>


        <!-- User Information Grid -->

        <div
            class="grid grid-cols-1 md:grid-cols-3
                   gap-6 mt-8 pt-6 border-t">

            <div>

                <p class="text-sm text-gray-500">
                    First Name
                </p>

                <p class="font-semibold text-gray-800 mt-1">
                    <%= selectedUser.firstName %>
                </p>

            </div>


            <div>

                <p class="text-sm text-gray-500">
                    Last Name
                </p>

                <p class="font-semibold text-gray-800 mt-1">
                    <%= selectedUser.lastName || "N/A" %>
                </p>

            </div>


            <div>

                <p class="text-sm text-gray-500">
                    Email
                </p>

                <p class="font-semibold text-gray-800 mt-1 break-all">
                    <%= selectedUser.email %>
                </p>

            </div>


            <div>

                <p class="text-sm text-gray-500">
                    User Type
                </p>

                <p class="font-semibold text-gray-800 mt-1">
                    <%= selectedUser.userType %>
                </p>

            </div>


            <div>

                <p class="text-sm text-gray-500">
                    Joined
                </p>

                <p class="font-semibold text-gray-800 mt-1">

                    <%= selectedUser.createdAt
                        ? new Date(selectedUser.createdAt)
                            .toLocaleDateString("en-IN")
                        : "N/A"
                    %>

                </p>

            </div>


            <div>

                <p class="text-sm text-gray-500">
                    User ID
                </p>

                <p class="font-mono text-xs text-gray-600 mt-1 break-all">
                    <%= selectedUser._id %>
                </p>

            </div>

        </div>

    </div>


    <!-- Statistics -->

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mt-6">

        <!-- Properties -->

        <div class="bg-white rounded-2xl shadow-md p-6">

            <p class="text-gray-500">
                Properties
            </p>

            <p class="text-3xl font-bold text-gray-800 mt-2">
                <%= homes.length %>
            </p>

        </div>


        <!-- Bookings -->

        <div class="bg-white rounded-2xl shadow-md p-6">

            <p class="text-gray-500">
                Bookings
            </p>

            <p class="text-3xl font-bold text-gray-800 mt-2">
                <%= bookings.length %>
            </p>

        </div>


        <!-- Favourites -->

        <div class="bg-white rounded-2xl shadow-md p-6">

            <p class="text-gray-500">
                Favourites
            </p>

            <p class="text-3xl font-bold text-gray-800 mt-2">
                <%= selectedUser.favourites
                    ? selectedUser.favourites.length
                    : 0
                %>
            </p>

        </div>

    </div>


    <!-- Properties -->

    <div class="bg-white rounded-2xl shadow-md p-6 md:p-8 mt-6">

        <div class="flex items-center justify-between">

            <h2 class="text-2xl font-bold text-gray-800">
                Properties
            </h2>

            <span class="text-gray-500">
                <%= homes.length %> total
            </span>

        </div>


        <% if (homes.length === 0) { %>

            <div class="text-center py-10">

                <p class="text-gray-500">
                    This user has no properties.
                </p>

            </div>

        <% } else { %>

            <div class="mt-6 space-y-4">

                <% homes.forEach(home => { %>

                    <div
                        class="border border-gray-200
                               rounded-xl p-5
                               hover:shadow-md transition">

                        <div
                            class="flex flex-col md:flex-row
                                   md:items-center
                                   md:justify-between gap-4">

                            <div>

                                <h3 class="text-lg font-bold text-gray-800">

                                    <%= home.houseName %>

                                </h3>

                                <p class="text-gray-500 mt-1">

                                    📍 <%= home.location %>

                                </p>

                            </div>


                            <div class="text-left md:text-right">

                                <p class="font-bold text-gray-800">

                                    ₹<%= home.price %>

                                </p>

                                <p class="text-sm text-gray-500">
                                    per night
                                </p>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>


    <!-- Bookings -->

    <div class="bg-white rounded-2xl shadow-md p-6 md:p-8 mt-6">

        <div class="flex items-center justify-between">

            <h2 class="text-2xl font-bold text-gray-800">
                Bookings
            </h2>

            <span class="text-gray-500">
                <%= bookings.length %> total
            </span>

        </div>


        <% if (bookings.length === 0) { %>

            <div class="text-center py-10">

                <p class="text-gray-500">
                    This user has no bookings.
                </p>

            </div>

        <% } else { %>

            <div class="mt-6 space-y-4">

                <% bookings.forEach(booking => { %>

                    <div
                        class="border border-gray-200
                               rounded-xl p-5">

                        <div
                            class="flex flex-col md:flex-row
                                   md:justify-between gap-4">

                            <div>

                                <h3 class="text-lg font-bold">

                                    <%= booking.home
                                        ? booking.home.houseName
                                        : "Property unavailable"
                                    %>

                                </h3>

                                <p class="text-gray-500 mt-1">

                                    <%= booking.home
                                        ? booking.home.location
                                        : ""
                                    %>

                                </p>

                            </div>


                            <!-- Status -->

                            <div>

                                <% if (booking.status === "Confirmed") { %>

                                    <span
                                        class="bg-green-100
                                               text-green-700
                                               px-3 py-1
                                               rounded-full text-sm">

                                        ✓ Confirmed

                                    </span>

                                <% } else { %>

                                    <span
                                        class="bg-red-100
                                               text-red-700
                                               px-3 py-1
                                               rounded-full text-sm">

                                        ✕ <%= booking.status %>

                                    </span>

                                <% } %>

                            </div>

                        </div>


                        <div
                            class="grid grid-cols-2 md:grid-cols-4
                                   gap-4 mt-5 pt-4 border-t">

                            <div>

                                <p class="text-sm text-gray-500">
                                    Check In
                                </p>

                                <p class="font-medium mt-1">

                                    <%= new Date(
                                        booking.checkIn
                                    ).toLocaleDateString("en-IN") %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Check Out
                                </p>

                                <p class="font-medium mt-1">

                                    <%= new Date(
                                        booking.checkOut
                                    ).toLocaleDateString("en-IN") %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Guests
                                </p>

                                <p class="font-medium mt-1">

                                    <%= booking.guests %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Total
                                </p>

                                <p class="font-bold mt-1">

                                    ₹<%= booking.totalPrice %>

                                </p>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</main>