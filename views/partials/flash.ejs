<% if(successMessage.length > 0){ %>

<div class="max-w-5xl mx-auto mt-5">

    <div class="bg-green-100 border border-green-400 text-green-700 px-5 py-4 rounded-lg">

        ✅ <%= successMessage[0] %>

    </div>

</div>

<% } %>

<% if(errorMessage.length > 0){ %>

<div class="max-w-5xl mx-auto mt-5">

    <div class="bg-red-100 border border-red-400 text-red-700 px-5 py-4 rounded-lg">

        ❌ <%= errorMessage[0] %>

    </div>

</div>

<% } %>