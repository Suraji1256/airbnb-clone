                                inline-flex items-center justify-center
                                gap-[7px]
                                whitespace-nowrap
                                rounded-lg
                                px-[14px] py-[9px]
                                text-sm font-medium
                                text-white no-underline
                                transition duration-200
                                hover:bg-[#f87171]
                                active:scale-[0.97]
                                <%= currentPage === 'payment-history'
                                    ? 'bg-[#dc2626] shadow-[inset_0_-2px_0_rgba(255,255,255,0.15),0_2px_5px_rgba(0,0,0,0.08)]'
                                    : '' %>
                            "
                        >

                            Payments

                        </a>

                    <% } else if (user && user.userType === "host") { %>

                        <!-- Payment History -->
                        <a
                            href="/payment/history"
                           class="
                                inline-flex items-center justify-center
                                gap-[7px]
                                whitespace-nowrap
                                rounded-lg
                                px-[14px] py-[9px]
                                text-sm font-medium
                                text-white no-underline
                                transition duration-200
                                hover:bg-[#f87171]
                                active:scale-[0.97]
                                <%= currentPage === 'payment-history'
                                    ? 'bg-[#dc2626] shadow-[inset_0_-2px_0_rgba(255,255,255,0.15),0_2px_5px_rgba(0,0,0,0.08)]'
                                    : '' %>
                            "
