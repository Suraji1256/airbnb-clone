                        text-gray-700 no-underline
                        transition duration-200
                        hover:bg-red-50 hover:text-red-500
                        <%= currentPage === 'addHome'
                            ? 'bg-red-50 text-red-600 font-semibold'
                            : '' %>
                    "
                >
                    ➕
                    <span>Add Home</span>
                </a>

            <% } %>



        <% if (user && user.userType === "admin") { %>

    <!-- ADMIN DASHBOARD -->

    <a
        href="/admin/dashboard"
        class="
            flex items-center gap-2.5
            rounded-lg
            px-[15px] py-3
            text-sm font-medium
            text-gray-700 no-underline
