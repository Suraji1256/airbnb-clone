<!-- ================= HEADER ================= -->
<header
    class="relative z-[100] bg-[#ef4444] text-white shadow-[0_3px_10px_rgba(0,0,0,0.15)]"
>

    <nav
    class="mx-auto flex max-w-7xl items-center
           justify-between
           px-3 sm:px-5
           py-3">

        <!-- ================= LEFT SIDE ================= -->
        <div class="flex min-w-0 items-center gap-[5px]">

            <!-- BRAND -->
            <a
                href="/"
                class="
                    inline-flex items-center
                    whitespace-nowrap
                    rounded-lg
                    px-[15px] py-[9px]
                    text-xl font-bold
                    text-white no-underline
                    transition duration-200
                    hover:bg-[#f87171]
                    active:scale-[0.97]
                    <%= currentPage === 'index'
                        ? 'bg-[#dc2626]'
                        : '' %>
                "
            >
                Airbnb
            </a>


            <!-- ================= MOBILE MENU BUTTON ================= -->
            <button
                type="button"
                class="
                    inline-flex h-10 w-10
                    items-center justify-center
                    rounded-lg
                    border-0
                    bg-transparent
                    text-2xl leading-none text-white
                    transition duration-200
                    hover:bg-[#f87171]
                    active:scale-[0.94]
                    md:hidden
                "
                onclick="toggleMobileMenu()"
                aria-label="Open navigation menu"
            >
                ☰
            </button>


            <!-- ================= DESKTOP NAVIGATION ================= -->

            <% if (isLoggedIn) { %>

                <div
                    class="
                        hidden
                        items-center
                        gap-1
                        ml-5
                        md:flex
                    "
                >

                    <% if (user && user.userType === "guest") { %>

                        <!-- LIST -->
                        <a
                            href="/homes"
                            class="
                                inline-flex items-center justify-center
                                gap-[7px]
                                whitespace-nowrap
                                rounded-lg
                                px-[14px] py-[9px]
                                text-sm font-medium
                                text-white no-underline
                                transition duration-200
                                hover:bg-[#f87171]
                                active:scale-[0.97]
                                <%= currentPage === 'Home'
                                    ? 'bg-[#dc2626] shadow-[inset_0_-2px_0_rgba(255,255,255,0.15),0_2px_5px_rgba(0,0,0,0.08)]'
                                    : '' %>
                            "
                        >
                            List
                        </a>


                        <!-- FAVOURITES -->
                        <a
                            href="/favourites"
                            class="
                                inline-flex items-center justify-center
                                gap-[7px]
                                whitespace-nowrap
                                rounded-lg
                                px-[14px] py-[9px]
                                text-sm font-medium
                                text-white no-underline
                                transition duration-200
                                hover:bg-[#f87171]
                                active:scale-[0.97]
                                <%= currentPage === 'favourites'
                                    ? 'bg-[#dc2626] shadow-[inset_0_-2px_0_rgba(255,255,255,0.15),0_2px_5px_rgba(0,0,0,0.08)]'
                                    : '' %>
                            "
                        >
                            Favourites
                        </a>


                        <!-- BOOKINGS -->
                        <a
                            href="/bookings"
                            class="
                                inline-flex items-center justify-center
                                gap-[7px]
                                whitespace-nowrap
                                rounded-lg
                                px-[14px] py-[9px]
                                text-sm font-medium
                                text-white no-underline
                                transition duration-200
                                hover:bg-[#f87171]
                                active:scale-[0.97]
                                <%= currentPage === 'bookings'
                                    ? 'bg-[#dc2626] shadow-[inset_0_-2px_0_rgba(255,255,255,0.15),0_2px_5px_rgba(0,0,0,0.08)]'
