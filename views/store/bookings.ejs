<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="max-w-6xl mx-auto px-4 py-8">

<h1 class="text-3xl font-bold mb-8">
    My Bookings
</h1>

<% if(bookings.length === 0){ %>

<div class="bg-white rounded-xl shadow-lg p-10 text-center">

    <h2 class="text-2xl font-semibold">
        No Bookings Yet
    </h2>

    <p class="text-gray-500 mt-3">
        Start exploring amazing homes.
    </p>

    <a
    href="/homes"
    class="inline-block mt-5 bg-red-500 text-white px-6 py-3 rounded-lg">

    Explore Homes

    </a>

</div>

<% } %>

<% bookings.forEach(booking=>{ %>

<div class="bg-white rounded-xl shadow-lg overflow-hidden mb-8">

<div class="md:flex">

    <div class="md:w-1/3">

        <% if (booking.home) { %>

            <img
                src="<%= booking.home.photo %>"
                alt="<%= booking.home.houseName %>"
                class="w-full h-64 object-cover">

        <% } else { %>

            <div class="w-full h-64 bg-gray-200 flex items-center justify-center">
                <p class="text-gray-500 text-center px-4">
                    This home is no longer available.
                </p>
            </div>

        <% } %>

    </div>


    <div class="md:w-2/3 p-6">

        <% if (booking.home) { %>

            <h2 class="text-2xl font-bold">
                <%= booking.home.houseName %>
            </h2>

            <p class="text-gray-600 mt-2">
                📍 <%= booking.home.location %>
            </p>

        <% } else { %>

            <h2 class="text-2xl font-bold text-gray-500">
                Home No Longer Available
            </h2>

            <p class="text-gray-500 mt-2">
                This property has been removed by the host.
            </p>

        <% } %>

<div class="grid grid-cols-2 gap-4 mt-5">

<div>

<strong>Check In</strong>

<p>

<%= booking.checkIn.toDateString() %>

</p>

</div>

<div>

<strong>Check Out</strong>

<p>

<%= booking.checkOut.toDateString() %>

</p>

</div>

<div>

<strong>Guests</strong>

<p>

<%= booking.guests %>

</p>

</div>

<div>

<strong>Total</strong>

<p>

₹<%= booking.totalPrice %>

</p>

</div>

</div>

<div class="mt-5 flex flex-wrap gap-2">

    <!-- Booking Status -->

    <% if (booking.status === "Pending") { %>

        <span 
            class="inline-flex items-center gap-2 
                   bg-yellow-100 text-yellow-700 
                   px-4 py-2 rounded-full font-medium">

            ⏳ Pending Approval

        </span>

    <% } else if (booking.status === "Confirmed") { %>

        <span 
            class="inline-flex items-center gap-2 
                   bg-green-100 text-green-700 
                   px-4 py-2 rounded-full font-medium">

            ✓ Confirmed

        </span>

    <% } else if (booking.status === "Cancelled") { %>

        <span 
            class="inline-flex items-center gap-2 
                   bg-red-100 text-red-700 
                   px-4 py-2 rounded-full font-medium">

            ✕ Cancelled

        </span>

    <% } %>


    <!-- Payment Status -->

    <% if (booking.paymentStatus === "Paid") { %>

        <span
            class="inline-flex items-center gap-2
                   bg-blue-100 text-blue-700
                   px-4 py-2 rounded-full font-medium">

            💳 Paid

        </span>

    <% } %>


    <% if (booking.paymentStatus === "Partially Refunded") { %>

        <span
            class="inline-flex items-center gap-2
                   bg-yellow-100 text-yellow-700
                   px-4 py-2 rounded-full font-medium">

            ↩ Partially Refunded

        </span>

    <% } %>


    <% if (booking.paymentStatus === "Refunded") { %>

        <span
            class="inline-flex items-center gap-2
                   bg-purple-100 text-purple-700
                   px-4 py-2 rounded-full font-medium">

            ↩ Refunded

        </span>

    <% } %>

</div>

<!-- Refund Information -->

<% if (booking.refundAmount > 0) { %>

    <div
        class="mt-5 bg-gray-50 border rounded-xl p-4"
        id="refund-box-<%= booking._id %>"
    >

        <h3 class="font-semibold text-lg">
            💰 Refund Information
        </h3>


        <!-- Booking Amount -->

        <div class="flex justify-between mt-3">

            <span class="text-gray-500">
                Booking Amount
            </span>

            <span class="font-semibold">
                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
            </span>

        </div>


        <!-- Refund Amount -->

        <div class="flex justify-between mt-2">

            <span class="text-gray-500">
                Refund Amount
            </span>

            <span class="font-semibold text-green-600">
                ₹<%= booking.refundAmount.toLocaleString("en-IN") %>
            </span>

        </div>


        <!-- Refund Status -->

        <div class="flex justify-between mt-2">

            <span class="text-gray-500">
                Refund Status
            </span>

            <span
                id="refund-status-<%= booking._id %>"
                class="font-semibold"
            >

                <% if (booking.refundStatus === "Pending") { %>

                    <span class="text-yellow-600">
                        ⏳ Processing
                    </span>

                <% } else if (
                    booking.refundStatus === "Processed"
                ) { %>

                    <span class="text-green-600">
                        ✓ Refunded
                    </span>

                <% } else if (
                    booking.refundStatus === "Failed"
                ) { %>

                    <span class="text-red-600">
                        ✕ Failed
                    </span>

                <% } %>

            </span>

        </div>


        <!-- Loading message -->

        <% if (booking.refundStatus === "Pending") { %>

            <p
                id="refund-checking-<%= booking._id %>"
                class="text-xs text-gray-500 mt-3"
            >
                🔄 Checking refund status...
            </p>

        <% } %>

    </div>

<% } %>

<% if (booking.status === "Pending") { %>

    <p class="text-sm text-yellow-600 mt-3">
        Please Make Payment for Confirm.
    </p>

<% } else if (booking.status === "Confirmed") { %>

    <p class="text-sm text-green-600 mt-3">
        Your booking has been confirmed.
        Have a great stay!
    </p>

<% } else if (booking.status === "Cancelled") { %>

    <p class="text-sm text-red-600 mt-3">
        This booking has been cancelled.
    </p>

<% } %>

<div class="mt-6 flex flex-wrap gap-3">

    <% if (
    booking.status === "Pending" &&
    booking.paymentStatus !== "Paid"
) { %>

    <!-- Pay Now -->
    <form
        action="/payment/create-order/<%= booking._id %>"
        method="POST">

        <button
            type="submit"
            class="bg-green-500 hover:bg-green-600
                   text-white px-5 py-2 rounded-lg
                   transition">

            💳 Pay Now

        </button>

    </form>

<% } %>

        <!-- Cancel Booking -->

    <% if (booking.status === "Pending" ||
            booking.status === "Confirmed") { %>

            <a
            href="/booking/cancel/<%= booking._id %>"
                class="bg-yellow-500 hover:bg-yellow-600 text-black px-5 py-2 rounded-lg transition">

                Cancel Booking

            </a>

        <% if (
    booking.status === "Confirmed" &&
    booking.paymentStatus === "Paid"
) { %>

    <a
        href="/review/<%= booking._id %>"
        class="bg-blue-500 hover:bg-blue-600
               text-white px-5 py-2 rounded-lg transition">

        ⭐ Write Review

    </a>

<% } %>

    <% } else { %>

        <span
            class="bg-red-100 text-red-700 px-4 py-2 rounded-full">

            Booking Cancelled

        </span>

        <!-- Delete Booking -->
        <form
            action="/booking/delete/<%= booking._id %>"
            method="POST"
            onsubmit="return confirm('Delete this booking permanently?');">

            <button
                class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-lg transition">

                Delete Booking

            </button>

        </form>

    <% } %>

</div>

</div>

</div>

</div>

<% }) %>



</main>

<script>

    const refundIntervals = {};


    async function checkRefundStatus(bookingId) {

        try {

            const response = await fetch(
                `/payment/refund-status/${bookingId}`
            );

            const data = await response.json();

            if (!data.success) {
                return;
            }


            const statusElement =
                document.getElementById(
                    `refund-status-${bookingId}`
                );


            const checkingElement =
                document.getElementById(
                    `refund-checking-${bookingId}`
                );


            if (!statusElement) {
                return;
            }


            // =========================
            // REFUND PROCESSED
            // =========================

            if (data.refundStatus === "Processed") {

                statusElement.innerHTML = `
                    <span class="text-green-600">
                        ✓ Refunded
                    </span>
                `;


                if (checkingElement) {

                    checkingElement.innerHTML =
                        "✓ Refund completed";

                }


                clearInterval(
                    refundIntervals[bookingId]
                );


                return;
            }


            // =========================
            // REFUND FAILED
            // =========================

            if (data.refundStatus === "Failed") {

                statusElement.innerHTML = `
                    <span class="text-red-600">
                        ✕ Refund Failed
                    </span>
                `;


                if (checkingElement) {

                    checkingElement.innerHTML =
                        "Refund could not be processed.";

                }


                clearInterval(
                    refundIntervals[bookingId]
                );


                return;
            }


            // =========================
            // REFUND PENDING
            // =========================

            statusElement.innerHTML = `
                <span class="text-yellow-600">
                    ⏳ Processing
                </span>
            `;


        } catch (error) {

            console.log(
                "Refund status error:",
                error
            );

        }

    }

    // =================================
    // AUTOMATIC REFUND STATUS CHECK
    // =================================

    <% bookings.forEach(booking => { %>

        <% if (booking.refundStatus === "Pending") { %>

            const bookingId =
                "<%= booking._id %>";


            // Check immediately
            checkRefundStatus(bookingId);


            // Check every 10 seconds
            refundIntervals[bookingId] =
                setInterval(() => {

                    checkRefundStatus(
                        bookingId
                    );

                }, 10000);

        <% } %>

    <% }) %>


</script>