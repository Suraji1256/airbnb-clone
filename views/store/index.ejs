<%- include('../partials/head') %>
</head>

<body class="bg-gray-50 font-sans">

    <%- include('../partials/header') %>
    <%- include("../partials/flash") %>

    <!-- Main Section -->
    <main class="max-w-7xl mx-auto px-5 py-10">

        <!-- Welcome Section -->
        <div class="text-center mb-12">

            <p class="text-rose-500 font-semibold text-sm uppercase tracking-wider mb-2">
                Find Your Perfect Stay
            </p>

            <h1 class="text-4xl md:text-5xl font-bold text-gray-800">
                Welcome To Our Homes 🏡
            </h1>

            <p class="text-gray-500 mt-3 max-w-2xl mx-auto">
                Discover comfortable and beautiful homes for your next stay.
                Choose a place that feels like home.
            </p>

        </div>


        <!-- Section Header -->
        <div class="flex items-center justify-between mb-6">

            <span class="hidden sm:block text-sm text-gray-500">
                <%= registeredHomes.length %> Homes
            </span>

        </div>


        <!-- Home Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">

            <% registeredHomes.forEach(home => { %>

            <!-- Home Card -->
            <div
                class="group bg-white rounded-2xl overflow-hidden
                       border border-gray-200
                       shadow-sm hover:shadow-xl
                       hover:-translate-y-1
                       transition-all duration-300">

                <!-- Image -->
                <div class="relative overflow-hidden">

                    <img
                        src="<%= home.photo %>"
                        alt="<%= home.houseName %>"
                        class="w-full h-56 object-cover
                               group-hover:scale-105
                               transition-transform duration-500">

                    <!-- Rating -->
                    <div
                        class="absolute top-3 right-3
                               bg-white/95 backdrop-blur-sm
                               px-3 py-1.5
                               rounded-full
                               shadow-md
                               text-sm font-semibold text-gray-800">

                        ⭐ <%= home.rating %>

                    </div>

                </div>


                <!-- Card Content -->
                <div class="p-5">

                    <!-- House Name -->
                    <h3
                        class="text-xl font-bold text-gray-800 truncate
                               group-hover:text-rose-600
                               transition-colors duration-200">

                        <%= home.houseName %>

                    </h3>


                    <!-- Location -->
                    <div class="flex items-center gap-1.5 mt-2">

                        <!-- Location Icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-rose-500 flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor">

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"/>

                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>

                        </svg>

                        <p class="text-gray-500 text-sm truncate">
                            <%= home.location %>
                        </p>

                    </div>


                    <!-- Divider -->
                    <div class="border-t border-gray-100 my-4"></div>


                    <!-- Price & Availability -->
                    <div class="flex items-end justify-between">

                        <!-- Price -->
                        <div>

                            <p class="text-xs text-gray-400 uppercase tracking-wide">
                                Starting from
                            </p>

                            <div class="mt-1">

                                <span class="text-2xl font-bold text-gray-900">
                                    ₹<%= home.price %>
                                </span>

                                <span class="text-sm text-gray-500">
                                    / night
                                </span>

                            </div>

                        </div>


                        <!-- Available -->
                        <span
                            class="bg-green-50
                                   border border-green-200
                                   text-green-600
                                   text-xs font-semibold
                                   px-3 py-1.5
                                   rounded-full">

                            Available

                        </span>

                    </div>


                    <!-- Explore Button -->
<div class="mt-6">

    <% if (isLoggedIn) { %>

        <!-- Logged In -->
        <a
            href="/homes"
            class="w-full flex items-center justify-center gap-2
                   bg-rose-500 hover:bg-rose-600
                   text-white font-semibold
                   py-3 rounded-xl
                   shadow-md hover:shadow-lg
                   hover:-translate-y-0.5
                   active:scale-95
                   transition-all duration-300">

            Explore Homes

            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">

                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>

        </a>

    <% } else { %>

        <!-- Not Logged In -->
        <a
            href="/login"
            class="w-full flex items-center justify-center gap-2
                   bg-rose-500 hover:bg-rose-600
                   text-white font-semibold
                   py-3 rounded-xl
                   shadow-md hover:shadow-lg
                   hover:-translate-y-0.5
                   active:scale-95
                   transition-all duration-300">

            Login to Explore

            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">

                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>

        </a>

    <% } %>

</div>

                </div>

            </div>

            <% }) %>

        </div>


        <!-- Empty State -->
        <% if (registeredHomes.length === 0) { %>

            <div class="text-center py-20">

                <div class="text-6xl mb-4">
                    🏡
                </div>

                <h2 class="text-2xl font-bold text-gray-700">
                    No Homes Available
                </h2>

                <p class="text-gray-500 mt-2">
                    Check back later for new homes.
                </p>

                <a
                    href="/homes"
                    class="inline-block mt-6
                           bg-rose-500 hover:bg-rose-600
                           text-white
                           px-6 py-3
                           rounded-xl
                           font-semibold
                           transition">

                    Explore Homes

                </a>

            </div>

        <% } %>

    </main>

</body>
</html>