<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main class="min-h-screen bg-gray-50 px-4 py-10">

    <div class="max-w-xl mx-auto">

        <!-- Back -->
        <a
            href="/bookings"
            class="inline-flex items-center gap-2
                   text-gray-600 hover:text-black
                   mb-6">

            ← Back to My Bookings

        </a>


        <!-- Card -->
        <div class="bg-white rounded-2xl shadow-lg
                    border border-gray-200 overflow-hidden">


            <!-- Header -->

            <div class="p-6 border-b">

                <h1 class="text-2xl font-bold text-gray-900">

                    Cancel Booking

                </h1>

                <p class="text-gray-500 mt-2">

                    Please review your refund before
                    cancelling this booking.

                </p>

            </div>


            <!-- Property -->

            <div class="p-6 border-b">

                <div class="flex gap-4">

                    <img
                        src="<%= booking.home.photo %>"
                        alt="<%= booking.home.houseName %>"
                        class="w-28 h-24 object-cover
                               rounded-xl">

                    <div>

                        <h2 class="text-lg font-bold">

                            <%= booking.home.houseName %>

                        </h2>

                        <p class="text-gray-500 mt-1">

                            📍 <%= booking.home.location %>

                        </p>

                    </div>

                </div>

            </div>


            <!-- Booking Details -->

            <div class="p-6 border-b">

                <h2 class="font-bold text-lg mb-4">

                    Booking Details

                </h2>


                <div class="grid grid-cols-2 gap-4">

                    <div>

                        <p class="text-gray-500 text-sm">
                            Check In
                        </p>

                        <p class="font-medium">
                            <%= booking.checkIn.toDateString() %>
                        </p>

                    </div>


                    <div>

                        <p class="text-gray-500 text-sm">
                            Check Out
                        </p>

                        <p class="font-medium">
                            <%= booking.checkOut.toDateString() %>
                        </p>

                    </div>


                    <div>

                        <p class="text-gray-500 text-sm">
                            Guests
                        </p>

                        <p class="font-medium">
                            <%= booking.guests %>
                        </p>

                    </div>


                    <div>

                        <p class="text-gray-500 text-sm">
                            Total Paid
                        </p>

                        <p class="font-medium">
                            ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                        </p>

                    </div>

                </div>

            </div>


            <!-- Refund Information -->

            <div class="p-6">

                <h2 class="font-bold text-lg mb-4">

                    Refund Information

                </h2>


                <div class="bg-gray-50 rounded-xl p-5">


                    <div class="flex justify-between mb-3">

                        <span class="text-gray-600">

                            Booking Amount

                        </span>

                        <span class="font-medium">

                            ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                        </span>

                    </div>


                    <div class="flex justify-between mb-3">

                        <span class="text-gray-600">

                            Refund Percentage

                        </span>

                        <span class="font-semibold">

                            <%= refundPercentage %>%

                        </span>

                    </div>


                    <div class="border-t my-4"></div>


                    <div class="flex justify-between">

                        <span class="font-bold text-lg">

                            Refund Amount

                        </span>

                        <span class="font-bold text-lg text-green-600">

                            ₹<%= refundAmount.toLocaleString("en-IN") %>

                        </span>

                    </div>

                </div>


                <!-- Policy Message -->

                <% if (refundPercentage === 100) { %>

                    <div class="mt-4 bg-green-50
                                border border-green-200
                                text-green-700
                                rounded-xl p-4">

                        ✓ You are eligible for a full refund.

                    </div>

                <% } else if (refundPercentage === 50) { %>

                    <div class="mt-4 bg-yellow-50
                                border border-yellow-200
                                text-yellow-700
                                rounded-xl p-4">

                        ⚠️ You are eligible for a 50% refund.

                    </div>

                <% } else { %>

                    <div class="mt-4 bg-red-50
                                border border-red-200
                                text-red-700
                                rounded-xl p-4">

                        ⚠️ This booking is not eligible
                        for a refund.

                    </div>

                <% } %>


                <!-- Actions -->

                <div class="flex flex-col sm:flex-row
                            gap-3 mt-6">


                    <!-- Keep Booking -->

                    <a
                        href="/bookings"
                        class="flex-1 text-center
                               border border-gray-300
                               hover:bg-gray-50
                               text-gray-700
                               px-5 py-3 rounded-xl
                               font-medium">

                        Keep Booking

                    </a>


                    <!-- Confirm Cancellation -->

                    <form
    action="/booking/cancel/<%= booking._id %>"
    method="POST"
>

    <button
        type="submit"
        class="bg-red-500 text-white px-6 py-3 rounded-lg"
    >
        Confirm Cancellation
    </button>

</form>

                </div>


                <p class="text-xs text-gray-400
                          text-center mt-4">

                    Your refund will be processed
                    according to the cancellation policy.

                </p>

            </div>

        </div>

    </div>

</main>